#
# Solution-wide shared environment variables (template).
# Copy this file to .env in the repo root and fill in real values.
# These are the variables that are identical across OdhApiCore and
# OdhApiImporter; anything project-specific lives in that project's
# own .env / .env.example instead. See README.md for the full setup.
#
# Variable names map directly to appsettings config keys, using "__"
# as the section separator (e.g. ConnectionStrings__PgConnection maps
# to config key ConnectionStrings:PgConnection).

# Postgres connection string used by both services
ConnectionStrings__PgConnection=

# Keycloak/OAuth authority URL used to validate API tokens
OauthServerConfig__Authority=

# Databrowser frontend URL (used in a few response links)
DataBrowserConfig__Url=

# LTS/LCS legacy availability interface credentials
LcsConfig__Username=
LcsConfig__Password=
LcsConfig__MessagePassword=
LcsConfig__ServiceUrl=

# LTS/CDB legacy availability interface credentials
CDBConfig__Username=
CDBConfig__Password=
CDBConfig__ServiceUrl=

# SIAG weather service credentials
SiagConfig__Username=
SiagConfig__Password=
SiagConfig__ServiceUrl=

# LTS API (IDM-facing, closed data)
LTSApiIDM__ServiceUrl=
LTSApiIDM__Username=
LTSApiIDM__Password=
LTSApiIDM__XLSClientid=
LTSApiIDM__Opendata=false

# LTS API (open data)
LTSApiOpen__ServiceUrl=
LTSApiOpen__Username=
LTSApiOpen__Password=
LTSApiOpen__XLSClientid=
LTSApiOpen__Opendata=true
