#
# OdhApiCore-specific environment variables (template).
# Copy this file to OdhApiCore/.env and fill in real values.
# Loaded AFTER the solution-wide ../.env (copied from ../.env.example),
# and overrides any key defined there. See README.md for the full setup.

# Optional Mongo connection (only used by a couple of legacy read paths)
ConnectionStrings__MongoDBConnection=mongodb://localhost:27017

# Local directories used to read/write xml and json cache files
XmlConfig__Xmldir=xml/
XmlConfig__XmldirWeather=xml/
JsonConfig__Jsondir=wwwroot/json/

# S3 bucket used by the imageresizer endpoints
S3ImageresizerConfig__Url=
S3ImageresizerConfig__BucketAccessPoint=
S3ImageresizerConfig__AccessKey=
S3ImageresizerConfig__SecretKey=

# Caddy proxy IPs allow-listed for certain internal endpoints
ProxyConfig__CaddyTest=
ProxyConfig__CaddyProd=

# Serilog Elasticsearch sink
ElasticSearchConfig__ElasticUrl=
ElasticSearchConfig__ElasticAuthtoken=

# HGV Mss availability interface
MssConfig__Username=
MssConfig__Password=
MssConfig__ServiceUrl=

# Suedtirol.info Raven interface
RavenConfig__Username=
RavenConfig__Password=
RavenConfig__ServiceUrl=

# Firebase push notification relay
PushServerConfig__Username=
PushServerConfig__Password=
PushServerConfig__ServiceUrl=

# Firebase Cloud Messaging (noi-communityapp)
FCMConfig__noi-communityapp__ServerKey=
FCMConfig__noi-communityapp__SenderId=
FCMConfig__noi-communityapp__ProjectName=
FCMConfig__noi-communityapp__FCMServiceAccount=

# S3 bucket for the weather forecast dataset
S3Config__dc-meteorology-province-forecast__AccessKey=
S3Config__dc-meteorology-province-forecast__AccessSecretKey=
S3Config__dc-meteorology-province-forecast__Filename=
